import math
import random

print("Simulador Quântico Avançado dos Elementos da Terra")
print("-" * 60)

# Função para escolher aleatoriamente entre superposição de elementos
def superposicao(*opcoes):
    return random.choice(opcoes)

# 1. Mentalismo — Tudo é Mente
agua = superposicao("calma", "turbulenta", "ondulante")
print(f"Mentalismo: A água está {agua}. Seu pensamento influencia a realidade.")

# 2. Correspondência — Como é acima, é abaixo
terra = superposicao("firme", "mole", "fragmentada")
print(f"Correspondência: A terra está {terra}. Seu microcosmo reflete o macrocosmo.")

# 3. Vibração — Tudo está em movimento
vento = superposicao("fraco", "moderado", "forte", "turbulento")
print(f"Vibração: O vento está {vento}. Frequência e energia se manifestam.")

# 4. Polaridade — Tudo tem seu oposto
fogo = superposicao("frio", "morno", "quente", "incandescente")
estado = "energia ativa" if fogo in ["quente", "incandescente"] else "energia receptiva"
print(f"Polaridade: O fogo está {fogo}. Polaridade atual → {estado}")

# 5. Ritmo — Tudo flui e reflui
maré = random.uniform(0, 10)  # simula altura ou intensidade
fase = (maré % (2 * math.pi))
amplitude_real = round(math.cos(fase), 3)
amplitude_imaginaria = round(math.sin(fase), 3)
print(f"Ritmo: O fluxo oscilou com fase {round(fase,3)} rad")
print(f"Amplitude real: {amplitude_real}, Amplitude imaginária: {amplitude_imaginaria}")

# 6. Causa e Efeito — Ação gera reação
acao = superposicao("pensamento", "fala", "movimento", "intenção")
efeito_dict = {
    "pensamento": "reflexo interno",
    "fala": "eco externo",
    "movimento": "impacto físico",
    "intenção": "influência energética"
}
print(f"Causa e Efeito: Sua ação '{acao}' gerou → {efeito_dict[acao]}")

# 7. Gênero — Tudo tem princípio masculino e feminino
ar = superposicao("ativa", "receptiva", "fluida")
genero = "masculina" if ar == "ativa" else "feminina"
print(f"Gênero: Energia {genero} — {ar}, equilíbrio da criação.")

print("-" * 60)
print("Sistema quântico simbólico avançado completo. O Universo reagiu de forma única à sua presença.")
